<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RetailEX.PrintServer.Designer</RootNamespace>
    <AssemblyName>RetailEX.FastReportDesigner</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
    <UserSecretsId>retailex-printserver-designer-1</UserSecretsId>
    <!-- RID restore için win-x64 bildirimi; publish ve build sırasında
         Windows runner'da apphost .exe üretimini garantiler. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintServer.Core\PrintServer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Designer kendi lib/ klasoru (lisansli DLL'ler buraya kopyalanir) -->
    <None Update="lib\*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="designer.config.example.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- qrprint kalibi: repo kokundeki tools/FastReportDesigner/lib/ dizinindeki
         FastReport*.dll dosyalarini otomatik olarak build output'a linkle. Boylece
         gelistirici lisansli DLL'leri tek bir yere koyar, hem lokal build hem
         CI Windows runner otomatik olarak DLL'leri tasarimci ile birlikte paketler. -->
    <None Include="$(MSBuildThisFileDirectory)..\..\tools\FastReportDesigner\lib\FastReport*.dll"
          Link="lib\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\FastReportDesigner\lib')" />
  </ItemGroup>

</Project>
