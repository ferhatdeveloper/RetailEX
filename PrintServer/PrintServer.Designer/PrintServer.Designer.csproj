<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RetailEX.PrintServer.Designer</RootNamespace>
    <AssemblyName>RetailEX.FastReportDesigner</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
    <UserSecretsId>retailex-printserver-designer-1</UserSecretsId>
    <!-- RID restore için win-x64 bildirimi; publish ve build sırasında
         Windows runner'da apphost .exe üretimini garantiler. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintServer.Core\PrintServer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="lib\*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="designer.config.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
