{
  "expo": {
    "name": "RetailEX",
    "slug": "retailex-mobile",
    "version": "0.1.309",
    "orientation": [
      "portrait",
      "landscape",
      "landscape-left",
      "landscape-right"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "retailex",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.retailex.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocationWhenInUseUsageDescription": "RetailEX teslimat kuryesi için canlı konum paylaşımı ister.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RetailEX teslimat sırasında konum güncellemesi ister.",
        "NSBluetoothAlwaysUsageDescription": "RetailEX BLE tartı terazisine bağlanmak için Bluetooth ister."
      },
      "buildNumber": "1309"
    },
    "android": {
      "package": "app.retailex.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2563eb",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "icon": "./assets/icon.png",
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "versionCode": 1309,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "retailexEasNotes": {
        "status": "unlinked",
        "checklist": "mobile/EAS_CHECKLIST.md",
        "userLoginRequired": "npx eas-cli@latest login  (veya EXPO_TOKEN) → whoami → npm run mobile:eas:init",
        "init": "npm run mobile:eas:init | headless: npm run mobile:eas:init -- --non-interactive [--force|--id UUID]",
        "projectId": "eas init sonrası expo.extra.eas.projectId yazılır; UUID uydurulmaz — bağlanana kadar extra.eas bloğu yoktur.",
        "ciAlign": "android-release.yml = assembleRelease APK (JS bundle gömülü; Metro yok). Opsiyonel Play: android-play-submit.yml. Bkz. PLAY_SUBMIT.md.",
        "profiles": "mobile/eas.json → debug | preview | production",
        "scripts": {
          "check": "npm run mobile:eas:check",
          "init": "npm run mobile:eas:init",
          "debug": "npm run mobile:eas:debug",
          "preview": "npm run mobile:eas:preview",
          "production": "npm run mobile:eas:production"
        }
      },
      "eas": {
        "projectId": "1c0bb17f-d0dd-4ca6-9c10-ec4c2a7f8b98"
      }
    },
    "plugins": [
      "./plugins/withCallerIdAndroid",
      [
        "./plugins/withIosMinDeploymentTarget",
        {
          "deploymentTarget": "16.4"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "RetailEX barkod okumak ve belge taramak için kameraya erişim ister.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RetailEX fatura belgesi seçmek için galeriye erişim ister.",
          "cameraPermission": "RetailEX fatura belgesi çekmek için kameraya erişim ister."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RetailEX teslimat kuryesi için canlı konum paylaşımı ister.",
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "RetailEX BLE tartı terazisine bağlanmak için Bluetooth ister."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "RetailEX belge kenarlarını bulup taramak için kameraya erişim ister."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "RetailEX taranmış belgeleri galeriye kaydetmek için fotoğraflara erişim ister.",
          "savePhotosPermission": "RetailEX taranmış belgeyi galeriye kaydetmek ister.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "owner": "ferhatnas"
  }
}
