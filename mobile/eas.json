{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "base": {
      "node": "22.14.0"
    },
    "debug": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "withoutCredentials": true,
        "applicationArchivePath": "android/app/build/outputs/apk/**/*.apk"
      },
      "ios": {
        "simulator": true,
        "withoutCredentials": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true
      },
      "distribution": "store",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6800660986",
        "ascApiKeyPath": "./secrets/AuthKey_99R4ZNAY3L.p8",
        "ascApiKeyId": "99R4ZNAY3L",
        "ascApiKeyIssuerId": "17205ca6-06e5-4420-80d8-47e38df03cee"
      }
    }
  }
}
