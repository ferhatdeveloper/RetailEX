        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(date_trunc('week', COALESCE(date,created_at)),'IYYY-\"W\"IW') AS hafta, count(*) AS fis, COALESCE(sum(total_net),0) AS ciro, COALESCE(avg(total_net),0) AS ort FROM rex_${firm}_${period}_sales WHERE COALESCE(is_cancelled,false)=false GROUP BY 1 ORDER BY 1 DESC LIMIT 26;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
