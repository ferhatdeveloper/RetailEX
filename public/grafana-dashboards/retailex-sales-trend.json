      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(date_trunc('day', COALESCE(date,created_at)),'YYYY-MM-DD') AS metric, COALESCE(sum(total_net),0)::float AS value FROM rex_${firm}_${period}_sales WHERE COALESCE(is_cancelled,false)=false GROUP BY 1 ORDER BY 1;"
