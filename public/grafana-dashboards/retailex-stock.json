    {
      "id": 5,
      "title": "Düşük stok (min/critical)",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT code, name, COALESCE(stock_quantity,0) AS stok,\n                min_stock, critical_stock, unit\n         FROM rex_${firm}_products\n         WHERE (critical_stock IS NOT NULL AND COALESCE(stock_quantity,0) <= critical_stock)\n            OR (min_stock IS NOT NULL AND COALESCE(stock_quantity,0) <= min_stock)\n         ORDER BY COALESCE(stock_quantity,0) ASC\n         LIMIT 100;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Son eklenen ürünler",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT code, name, brand, sale_price, purchase_price, created_at\n         FROM rex_${firm}_products\n         ORDER BY created_at DESC NULLS LAST\n         LIMIT 50;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Kategori / grup dağılımı",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(category_code,'(yok)') AS kategori,\n                COALESCE(group_code,'(yok)') AS grup,\n                count(*)::int AS adet\n         FROM rex_${firm}_products\n         GROUP BY 1,2 ORDER BY adet DESC LIMIT 50;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
