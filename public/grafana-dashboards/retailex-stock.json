    {
      "id": 3,
      "title": "Kritik stok altı",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*)::int AS value FROM rex_${firm}_products\n         WHERE critical_stock IS NOT NULL AND COALESCE(stock_quantity,0) <= critical_stock;"
        }
      ],
