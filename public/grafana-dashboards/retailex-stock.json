      }
    },
    {
      "id": 4,
      "title": "Stok hareket satırı",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*)::int AS value FROM information_schema.tables t\n         WHERE t.table_name = 'rex_${firm}_${period}_stock_movement_items';"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
