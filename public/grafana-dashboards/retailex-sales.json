    {
      "id": 5,
      "title": "Günlük satış (son 30 gün)",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', COALESCE(fiche_date::timestamp, created_at))::date AS gun,\n                count(*)::int AS fis,\n                COALESCE(sum(total_net),0)::numeric(18,2) AS net\n         FROM rex_${firm}_${period}_sales\n         WHERE COALESCE(is_cancelled,false)=false\n           AND COALESCE(fiche_date::timestamp, created_at) >= now() - interval '30 days'\n         GROUP BY 1 ORDER BY 1 DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Ödeme yöntemine göre",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(payment_method,'(yok)') AS odeme,\n                count(*)::int AS fis,\n                COALESCE(sum(total_net),0)::numeric(18,2) AS net\n         FROM rex_${firm}_${period}_sales\n         WHERE COALESCE(is_cancelled,false)=false\n         GROUP BY 1 ORDER BY net DESC LIMIT 20;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Son 50 satış fişi",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT fiche_no, fiche_date, customer_name, payment_method,\n                total_net, total_vat, is_cancelled, created_at\n         FROM rex_${firm}_${period}_sales\n         ORDER BY created_at DESC NULLS LAST\n         LIMIT 50;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
