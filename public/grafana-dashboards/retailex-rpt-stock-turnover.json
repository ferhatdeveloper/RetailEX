      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT si.item_code, si.item_name, sum(si.quantity) AS satilan, COALESCE(max(p.stock),0) AS stok FROM rex_${firm}_${period}_sale_items si LEFT JOIN rex_${firm}_products p ON p.id=si.product_id OR p.code=si.item_code GROUP BY 1,2 ORDER BY satilan DESC LIMIT 100;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
