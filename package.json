      "scripts": {
            "test": "vitest --config src/vitest.config.ts",
            "test:run": "vitest run --config src/vitest.config.ts",
            "test:coverage": "vitest run --config src/vitest.config.ts --coverage",
            "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit --pretty false",
            "dev": "vite",
            "start": "vite",
            "prebuild": "node scripts/sync-app-version.mjs && node scripts/sync-pg-expose.mjs && node scripts/build-postgres-remote-enable.mjs",
            "build": "vite build",
            "build:docker": "node scripts/sync-app-version.mjs && vite build",
            "build:analyze": "vite build --mode analyze",
            "build:services:win": "node scripts/build-service-exes.mjs",
            "preview": "vite preview",
            "deploy": "vercel --prod",
            "deploy:preview": "vercel",
            "vercel:build": "npm run build",
            "tauri": "tauri",
            "sumatra:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File DeskApp/scripts/fetch-sumatra-portable.ps1",
            "postgrest:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File DeskApp/scripts/fetch-postgrest-windows.ps1",
            "tauri:dev": "npm run sumatra:fetch && cd DeskApp && tauri dev",
            "tauri:build": "npm run prebuild && npm run sumatra:fetch && npm run postgrest:fetch && node scripts/patch-installer-nsi-repo-root.mjs && node scripts/tauri-windows-signing-prep.mjs && cd DeskApp && tauri build && cd .. && node scripts/verify-windows-installer-signature.mjs",
            "desktop:ci:fetch": "node scripts/fetch-desktop-release-to-desktop.mjs",
            "desktop:ci:build": "node scripts/trigger-desktop-release.mjs",
            "desktop:ci:cleanup": "node scripts/cleanup-github-desktop-releases.mjs",
            "tauri:windows-signing:example": "node -e \"const fs=require('fs');const p='DeskApp/tauri.windows.conf.json';if(fs.existsSync(p))throw new Error(p+' zaten var');fs.copyFileSync('DeskApp/tauri.windows.conf.json.example',p);console.log(p+' olusturuldu; certificateThumbprint doldurun.');\"",
            "electron:dev": "electron ./src/electron/main.js --dev",
            "bridge": "npx tsx src/services/pg_bridge.ts",
            "whatsapp:bridge:install": "npm install --prefix scripts/whatsapp-bridge",
            "whatsapp:bridge": "node scripts/whatsapp-bridge/server.mjs",
            "scale:bridge": "node scripts/scale-bridge/server.mjs",
            "scale:bridge:ui": "node scripts/scale-bridge/server.mjs",
            "scale:bridge:diagnose": "node scripts/scale-bridge/diagnose-scale.mjs",
            "scale:bridge:validate": "node scripts/scale-bridge/validate-package.mjs scripts/scale-bridge",
            "scale-bridge:fetch-docs": "node scripts/scale-bridge/sdk/fetch-official-docs.mjs",
            "dev:with-bridge": "npx --yes concurrently -k -n bridge,vite -c blue,green \"npm run bridge\" \"npm run dev\"",
            "dev:with-wa": "npx --yes concurrently -k -n wa,vite -c magenta,green \"npm run whatsapp:bridge\" \"npm run dev\"",
            "postgrest": "postgrest config/postgrest.conf",
            "db:migrate": "node database/scripts/run-pending-migrations.mjs",
            "db:migrate:dry": "node database/scripts/run-pending-migrations.mjs --dry-run",
            "db:migrate:env": "node database/scripts/run-pending-migrations.mjs --env-only",
            "db:migrate:remote": "node scripts/migrate-remote-pg.mjs",
            "db:migrate:remote:dry": "node scripts/migrate-remote-pg.mjs --dry-run",
            "db:migrate:tenants": "node scripts/migrate-all-tenant-dbs.mjs",
            "db:migrate:tenants:dry": "node scripts/migrate-all-tenant-dbs.mjs --dry-run",
            "db:migrate:065:tenants": "node scripts/migrate-all-tenant-dbs.mjs --from-registry",
            "db:postgrest:reload": "node database/scripts/postgrest-reload-schema.mjs",
            "db:postgrest:reload:tenants": "node scripts/postgrest-reload-all-tenants.mjs",
            "db:test:remote": "node scripts/test-remote-pg.mjs",
            "db:validate:stock": "node scripts/db/validate-stock.mjs",
            "db:validate:stock:kasap": "node scripts/db/validate-stock.mjs --database kasap --firm 001 --period 01",
            "db:firm": "node database/scripts/firm-quick.mjs",
            "db:merkez:tenant-retail-seed": "node scripts/run-merkez-tenant-registry-retail-seed.mjs",
            "db:provision-tenant": "node scripts/provision-tenant.mjs",
            "db:merkez:tenant-retail-full-setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/merkez-tenant-retail-full-setup.ps1",
            "db:tenant-post-schema": "node scripts/tenant-databases-post-schema.mjs",
            "db:tenant-ensure-app-users": "node scripts/tenant-databases-ensure-app-users.mjs"
