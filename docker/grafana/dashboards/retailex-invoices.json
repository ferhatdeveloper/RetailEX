  "panels": [
    {
      "id": 1,
      "title": "Fiş tipine göre (trcode)",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(trcode::text,'(yok)') AS trcode,\n                count(*)::int AS adet,\n                COALESCE(sum(total_net),0)::numeric(18,2) AS net\n         FROM rex_${firm}_${period}_sales\n         WHERE COALESCE(is_cancelled,false)=false\n         GROUP BY 1 ORDER BY adet DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Aylık ciro",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(date_trunc('month', COALESCE(fiche_date::timestamp, created_at)), 'YYYY-MM') AS ay,\n                count(*)::int AS fis,\n                COALESCE(sum(total_net),0)::numeric(18,2) AS net\n         FROM rex_${firm}_${period}_sales\n         WHERE COALESCE(is_cancelled,false)=false\n         GROUP BY 1 ORDER BY 1 DESC LIMIT 24;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "En çok satılan ürünler (kalem)",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(item_code, product_id::text) AS kod,\n                COALESCE(item_name,'(adsız)') AS ad,\n                sum(quantity)::numeric(18,3) AS miktar,\n                sum(total_amount)::numeric(18,2) AS tutar\n         FROM rex_${firm}_${period}_sale_items\n         GROUP BY 1,2 ORDER BY tutar DESC NULLS LAST LIMIT 50;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
