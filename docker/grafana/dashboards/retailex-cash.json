      "id": 2,
      "title": "Giriş toplamı (pozitif)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(sum(CASE WHEN amount > 0 THEN amount ELSE 0 END),0)::float AS value\n         FROM rex_${firm}_${period}_cash_lines;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyTRY"
        },
