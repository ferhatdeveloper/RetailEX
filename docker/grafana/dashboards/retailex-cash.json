    {
      "id": 3,
      "title": "Çıkış toplamı (negatif abs)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(sum(CASE WHEN amount < 0 THEN abs(amount) ELSE 0 END),0)::float AS value\n         FROM rex_${firm}_${period}_cash_lines;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyTRY"
        },
