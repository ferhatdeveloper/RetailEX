    },
    {
      "id": 4,
      "title": "Günlük kasa net",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', COALESCE(line_date::timestamp, created_at))::date AS gun,\n                COALESCE(sum(amount),0)::numeric(18,2) AS net,\n                count(*)::int AS satir\n         FROM rex_${firm}_${period}_cash_lines\n         GROUP BY 1 ORDER BY 1 DESC LIMIT 60;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Son 80 kasa hareketi",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT line_date, description, amount, payment_method, created_at\n         FROM rex_${firm}_${period}_cash_lines\n         ORDER BY COALESCE(line_date::timestamp, created_at) DESC NULLS LAST\n         LIMIT 80;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
