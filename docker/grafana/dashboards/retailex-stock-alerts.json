  "panels": [
    {
      "id": 1,
      "title": "Düşük / kritik stok",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT code, name, COALESCE(stock,0) AS stok, COALESCE(min_stock,0) AS min_stok, COALESCE(critical_stock,0) AS kritik, COALESCE(price,0) AS fiyat FROM rex_${firm}_products WHERE COALESCE(stock,0) <= GREATEST(COALESCE(min_stock,0), COALESCE(critical_stock,0)) ORDER BY stok ASC NULLS LAST LIMIT 100;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "SKT yaklaşan (sale_items)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT item_code, item_name, expiry_date, sum(quantity) AS qty FROM rex_${firm}_${period}_sale_items WHERE expiry_date IS NOT NULL AND expiry_date <= CURRENT_DATE + INTERVAL '60 days' GROUP BY 1,2,3 ORDER BY expiry_date ASC LIMIT 100;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
