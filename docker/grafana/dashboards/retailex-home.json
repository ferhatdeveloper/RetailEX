      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT n.nspname AS schema, c.relname AS table_name,\n            pg_size_pretty(pg_total_relation_size(c.oid)) AS total_size,\n            pg_total_relation_size(c.oid) AS size_bytes\n     FROM pg_class c\n     JOIN pg_namespace n ON n.oid = c.relnamespace\n     WHERE c.relkind = 'r' AND n.nspname NOT IN ('pg_catalog','information_schema')\n     ORDER BY pg_total_relation_size(c.oid) DESC\n     LIMIT 30;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
