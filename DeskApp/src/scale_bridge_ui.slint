import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct ScaleRow {
    id: string,
    label: string,
    ip: string,
    port: string,
    name: string,
}

export component ScaleBridgeWindow inherits Window {
    title: "RetailEX Terazi Köprüsü";
    width: 720px;
    height: 620px;
    background: #f0f4f8;

    callback save-settings();
    callback reload-config();
    callback add-scale();
    callback update-scale();
    callback delete-scale();
    callback test-scale();
    callback probe-scale();
    callback scan-network();
    callback install-service();
    callback select-scale(int);
    callback open-web-ui();

    in-out property <string> store-code: "";
    in-out property <string> store-name: "";
    in-out property <string> auth-token: "";
    in-out property <string> scale-name: "";
    in-out property <string> scale-ip: "";
    in-out property <string> scale-port: "20304";
    in-out property <string> service-status: "Kontrol ediliyor…";
    in-out property <string> status-msg: "Hazır";
    in-out property <int> selected-index: -1;
    in-out property <[ScaleRow]> scales: [];

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "RetailEX Terazi Köprüsü";
            font-size: 22px;
            font-weight: 800;
            color: #1e3a5f;
        }
        Text {
            text: "Mağaza ayarları ve terazi yönetimi (masaüstü)";
            font-size: 13px;
            color: #64748b;
        }

        Rectangle {
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cbd5e1;
            VerticalBox {
                padding: 12px;
                spacing: 8px;
                Text { text: "GENEL"; font-size: 11px; font-weight: 700; color: #64748b; }
                HorizontalBox {
                    spacing: 10px;
                    VerticalBox {
                        spacing: 4px;
                        Text { text: "Mağaza kodu"; font-size: 12px; }
                        LineEdit { text <=> root.store-code; height: 32px; }
                    }
                    VerticalBox {
                        spacing: 4px;
                        Text { text: "Mağaza adı"; font-size: 12px; }
                        LineEdit { text <=> root.store-name; height: 32px; }
                    }
                }
                VerticalBox {
                    spacing: 4px;
                    Text { text: "Token (authToken)"; font-size: 12px; }
                    LineEdit { text <=> root.auth-token; height: 32px; }
                }
                Text { text: "Servis: " + root.service-status; font-size: 12px; color: #334155; }
            }
        }

        Rectangle {
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cbd5e1;
            VerticalBox {
                padding: 12px;
                spacing: 8px;
                Text { text: "KAYITLI TERAZİLER"; font-size: 11px; font-weight: 700; color: #64748b; }
                ScrollView {
                    height: 140px;
                    VerticalBox {
                        alignment: start;
                        spacing: 4px;
                        for scale[i] in root.scales : Rectangle {
                            height: 32px;
                            background: i == root.selected-index ? #dbeafe : #f8fafc;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: i == root.selected-index ? #3b82f6 : #e2e8f0;
                            TouchArea {
                                clicked => {
                                    root.selected-index = i;
                                    root.select-scale(i);
                                }
                            }
                            HorizontalBox {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: scale.label;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cbd5e1;
            VerticalBox {
                padding: 12px;
                spacing: 8px;
                Text { text: "TERAZİ EKLE / DÜZENLE"; font-size: 11px; font-weight: 700; color: #64748b; }
                HorizontalBox {
                    spacing: 10px;
                    VerticalBox {
                        spacing: 4px;
                        Text { text: "Ad"; font-size: 12px; }
                        LineEdit { text <=> root.scale-name; height: 32px; }
                    }
                    VerticalBox {
                        spacing: 4px;
                        Text { text: "IP"; font-size: 12px; }
                        LineEdit { text <=> root.scale-ip; height: 32px; }
                    }
                    VerticalBox {
                        spacing: 4px;
                        Text { text: "Port"; font-size: 12px; }
                        LineEdit { text <=> root.scale-port; width: 90px; height: 32px; }
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    Button { text: "Ekle"; clicked => { root.add-scale(); } }
                    Button { text: "Güncelle"; clicked => { root.update-scale(); } }
                    Button { text: "Sil"; clicked => { root.delete-scale(); } }
                    Button { text: "Test"; primary: true; clicked => { root.test-scale(); } }
                    Button { text: "Bağlantı kontrol"; clicked => { root.probe-scale(); } }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button { text: "Yenile"; clicked => { root.reload-config(); } }
            Button { text: "Ağı tara"; clicked => { root.scan-network(); } }
            Button { text: "Kaydet"; primary: true; clicked => { root.save-settings(); } }
            Button { text: "Servis kur"; clicked => { root.install-service(); } }
            Button { text: "Web arayüz"; clicked => { root.open-web-ui(); } }
        }

        Rectangle {
            background: #1e293b;
            border-radius: 6px;
            height: 36px;
            HorizontalBox {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: root.status-msg;
                    color: #e2e8f0;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
