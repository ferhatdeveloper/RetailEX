# RetailEX web (Vite) — statik çıktı + Nginx
# Build: DOCKER_BUILDKIT=1 docker build -f Dockerfile.frontend -t retailex-web .
# Çalıştır: berqenas docker-compose ile veya: docker run -p 8080:80 retailex-web

# Vite 6 / toolchain: node >= 22
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
# antd 6 + @ant-design/pro-components peer uyumsuzlugu; Docker/VPS imaji icin gerekli
# npm cache mount: paket indirmelerini tekrarlamayı azaltır
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --legacy-peer-deps

COPY . .
ENV SKIP_POSTGRES_REMOTE_ENABLE=1
ENV DOCKER_BUILD=1
# Vite "rendering chunks" bellek zirvesi (Dokploy/VPS OOM). Host RAM bol ise:
#   docker build --build-arg NODE_MAX_OLD_SPACE=3072 …
ARG NODE_MAX_OLD_SPACE=2560
ENV NODE_OPTIONS=--max-old-space-size=${NODE_MAX_OLD_SPACE}
ENV CI=1
# Rollup / UV thread havuzu — chunk render zirvesini düşür
ENV UV_THREADPOOL_SIZE=2
# VPS: merkez PostgREST HTTPS tabanı (örn. https://api.retailex.app/merkez) — bos ise build zamanı env yok
ARG VITE_MERKEZ_REST_URL=
ENV VITE_MERKEZ_REST_URL=${VITE_MERKEZ_REST_URL}
# Koprü her zaman web ile aynı origin (Nginx /api → retailex_bridge); api.* alt alanına asla sabitlemeyin
ARG VITE_BRIDGE_URL=
ENV VITE_BRIDGE_URL=${VITE_BRIDGE_URL}
# Dokploy/pg_bridge: PG_DUMP_TOKEN kullanılıyorsa köprü ile aynı değer (build zamanı bundle’a gider)
ARG VITE_PG_DUMP_INTERNAL=
ENV VITE_PG_DUMP_INTERNAL=${VITE_PG_DUMP_INTERNAL}
# Vite önbelleği (transform / optimize) — büyük modül grafiğinde yeniden build’i hızlandırır
# Start/DONE satırları: log kesilse bile tamamlanma/OOM ayrımı yapılabilsin
RUN --mount=type=cache,target=/app/node_modules/.vite,sharing=locked \
    sh -c 'set -e; \
      echo "[frontend] vite build start $(date -u +%Y-%m-%dT%H:%M:%SZ) NODE_OPTIONS=${NODE_OPTIONS}"; \
      npm run build:docker; \
      echo "[frontend] vite build DONE $(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
      test -f /app/build/index.html'

FROM nginx:alpine
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
